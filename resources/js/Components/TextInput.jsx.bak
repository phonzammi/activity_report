import { forwardRef, useEffect, useRef } from 'react';

export default forwardRef(function TextInput({ type = 'text', className = '', isFocused = false, isInvalid, ...props }, ref) {
    const input = ref ? ref : useRef();

    useEffect(() => {
        if (isFocused) {
            input.current.focus();
        }
    }, []);

    return (
        <div className="flex flex-col items-start">
            <input
                {...props}
                type={type}
                className={
                    `border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 rounded-md shadow-sm ${isInvalid && "bg-red-50 border border-red-500 focus:border-red-500 focus:ring-red-500 text-red-900 placeholder-red-700"}` +
                    className
                }
                isInvalid={isInvalid}
                ref={input}
            />
        </div>
    );
});
